LLM_API_KEY=
# OpenRouter API base URL and your OpenRouter API key (LLM_API_KEY above).
# MODEL below uses OpenRouter's "provider/model" slug format.
LLM_BASE_URL=https://openrouter.ai/api/v1
MODEL=google/gemini-3.1-flash-lite
TEMPERATURE=0.2
MAX_TOKENS=1000
REQUEST_TIMEOUT=30
# Space-separated CSP source list of origins allowed to <iframe> /widget.
# Defaults to 'self' (no external embedding). Add every site that will embed the
# widget, e.g. the pages you're testing on plus eventual VU domains:
# WIDGET_FRAME_ANCESTORS='self' https://simas.private-search.online https://*.vu.lt https://vu.lt
WIDGET_FRAME_ANCESTORS='self'
# Per-IP limit on POST /chat (slowapi syntax: "N/second|minute|hour|day").
CHAT_RATE_LIMIT=10/minute

# --- Contact form / email (SMTP) --------------------------------------------
# Where "Contact staff" messages are delivered.
CONTACT_TO_EMAIL=
# From address they appear to come from. Use an address on a domain the SMTP
# server is allowed to send for (usually the mailbox's own domain). Example:
# CONTACT_FROM_EMAIL=Simas asistentas <info@example.com>
CONTACT_FROM_EMAIL=
# Per-IP limit on POST /contact — kept strict since it sends email.
CONTACT_RATE_LIMIT=5/hour
# SMTP relay that actually sends the mail (a mailbox provider, or later VU's
# institutional mail server). SMTP_USERNAME is usually the full email address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
